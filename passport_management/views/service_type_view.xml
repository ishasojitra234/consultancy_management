<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="view_service_type_tree" model="ir.ui.view">
		<field name="name">service.type.tree</field>
		<field name="model">service.type</field>
		<field name="arch" type="xml">
			<tree>
				<field name="name"/>
			</tree>
		</field>
	</record>

	<record id="view_service_type_form" model="ir.ui.view">
		<field name="name">service.type.form</field>
		<field name="model">service.type</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_title">
						<h1>
							<field name="name" placeholder="Enter Name Here..." />
						</h1>
					</div>
					<br/>
					<group>
						<group>
							<field name="fees_amount" />
							<field name="document_type_ids" widget="many2many_tags" />
						</group>
					</group>
					<group string="Document" />
					<field name="document_ids">
						<tree>
							<field name="name"/>
							<field	name ="doc_type_id"/>
						</tree>
					</field>
				</sheet>
				<div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
			</form>
		</field>
	</record>

	<record model="ir.actions.act_window" id="action_service_type">
		<field name="name">Service</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">service.type</field>
		<field name="view_mode">tree,form</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				No Record Found
			</p>
		</field>
	</record>



</odoo>
