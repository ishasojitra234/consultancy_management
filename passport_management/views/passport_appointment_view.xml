<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_appointment_kanban" model="ir.ui.view">
        <field name="name">appointment.kanban</field>
        <field name="model">appointment.appointment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_example" sample="1">
                <field name="name"/>
                <field name="first_name"/>
                <field name="customer_id"/>
                <field name="state"/>
                <field name="state_id" />
                <field name="country_id"/>
                <field name="verification_date"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="booking_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card">
                            <div class="o_kanban_header">
                                <strong class="o_kanban_record_title" style="font-size: 18px;">
                                    <field name="name"/>
                                </strong>
                            </div>
                            
                            <!-- Details Section -->
                            <div class="o_kanban_details" style="padding: 0;">
                                <ul style="list-style: none; padding: 0; margin: 0;">
                                    <li style="display: inline-block; padding: 0; margin: 0;"> 
                                        <li t-if="record.first_name.raw_value">
                                            <span style="font-weight: bold;"> 
                                            <field name="first_name"/></span>
                                        </li>
                                        <li t-if="record.email.raw_value">
                                            <span style="font-weight: bold;">Email:</span> 
                                            <span style="margin-left: 10px;"><field name="email"/></span>
                                        </li>
                                        <li t-if="record.phone.raw_value">
                                            <span style="font-weight: bold;">Phone:</span> 
                                            <span style="margin-left: 10px;"><field name="phone"/></span>
                                        </li>
                                        <li t-if="record.country_id.raw_value">
                                            <span style="font-weight: bold;"> 
                                            <field name="country_id"/></span>
                                        </li>
                                        <li t-if="record.state_id.raw_value">
                                            <span style="font-weight: bold;"> 
                                            <field name="state_id"/></span>
                                        </li>
                                    </li>
                                </ul>
                            </div>
                            
                            <!-- Tags Section -->
                            <div class="o_kanban_tags" style="margin-top: 5px; font-size: 18px; color: #fff;">
                                <span class="badge bg-primary">
                                    <field name="state"/>
                                </span>
                            </div>
                            
                            <!-- Footer Section -->
                            <div class="o_kanban_footer" style="margin-top: 5px;">
                                <span style="font-weight: bold; font-size: 15px;">Appointment Date:</span>
                                <span style="margin-right: 80px;"><field name="booking_date"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_passport_appointment_tree" model="ir.ui.view">
        <field name="name">appointment.appointment.tree</field>
        <field name="model">appointment.appointment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="first_name"/>
                <field name="mid_name"/>
                <field name="last_name" />
                <field name="mobile" />
                <field name="service_type" />
                <field name="passport_type"/>
                <field name="state"/>
                <field name="gender" />
                <field name="age" />
            </tree>
        </field>
    </record>

    <record id="view_appointment_calendar" model="ir.ui.view">
        <field name="name">appointment.calendar</field>
        <field name="model">appointment.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments" date_start="verification_date">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>


    <record id="view_passport_appointment_form" model="ir.ui.view">
        <field name="name">appointment.appointment.form</field>
        <field name="model">appointment.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name= "send_whatsapp_message" string="Whatsapp" type="object"></button> 
                    <button name= "send_whatsapp_draft_message" string="Whatsapp Draft" type="object"></button> 
                    <button name= "action_open_payment_wizard" string="Payment" type="object" data-hotkey='c' invisible="due_amount == False"></button> 
                    <button name="action_in_draft" string="Set To Draft" type="object" invisible="state != 'Cancel'"/>
                    <button name="action_in_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'Draft'"/>
                    <button name="action_in_Process" string="In Process" type="object" class="oe_highlight" invisible=" state != 'Confirm'"/>
                    <button name="action_in_Get_Appointment" string="Get Appointment" type="object" class="oe_highlight" invisible="state != 'In Process'"/>
                    <button name="action_in_Get_Appointment" string="Reschedule" type="object" class="oe_highlight" invisible="state not in ('Get Appointment','Office Visit')"/>
                    <button name="action_in_Office_Visit" string="Office Visit" type="object" class="oe_highlight" invisible="state != 'Get Appointment'"/>
                    <button name="action_in_Police_Verification" string="Police Verification" type="object" class="oe_highlight" invisible="state != 'Office Visit'"/>
                    <button name="action_in_Done" string="Done" type="object" class="oe_highlight" invisible="state != 'Police Verification'"/>
                    <button name="action_in_Cancel" string="Cancel" type="object" invisible="state not in ('Office Visit','In Process')"/>
                    <field name="state" widget="statusbar" nolabel="1"/>
                </header>
                <sheet>
                 <div class="oe_button_box" name="button_box">
                        <button name="action_view_document" type="object" class="oe_stat_button" icon="fa-list">
                            <field string="Documents" name="document_count" widget="statinfo"/>
                        </button>
                        <button name="action_view_payment" invisible="payment_ids == False" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="payment_ids" invisible="1" />
                            <field string="Payment" name="payment_count" widget="statinfo"/>
                        </button>
                    </div>
                
                    <div class="oe_nationality">
                        <h1>
                            <field name="name" placeholder="Enter Name Here..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <!-- <field name="customer_id" context="{'form_view_ref': 'passport_management.view_partner_form_passport'}"/> -->
                            <field name="first_name" placeholder="Please Enter First Name"/>
                            <field name="mid_name" placeholder="Please Enter Middle Name"/>
                            <field name="last_name" placeholder="Please Enter Last Name"/>
                            <field name="gender" options="{'horizontal': true}" widget="radio" />
                            <field name="nationality" />
                            <field name="phone" placeholder="Please Enter Phone Number"/>
                            <field name="mobile" placeholder="Please Enter Mobile Number"/>
                            <field name="email" placeholder="Please Enter Email Address"/>
                            <field name="birth_space" placeholder="Please Enter Birth Date"/>
                            <field name="marital_status" options="{'horizontal': true}" widget="radio" />
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="date_of_birth" />
                            <field name="age" />
                            <field name="father_passport_number" invisible="age > 15" placeholder="Please Enter Father Passport Number"/>
                            <field name="father_nationality" invisible="age > 15" placeholder="Please Enter Father Nationality"/>
                            <field name="mother_passport_number" invisible="age > 15" placeholder="Please Enter Mother Passport Number"/>
                            <field name="mother_nationality" invisible="age > 15" placeholder="Please Enter Mother Nationality"/>
                        </group>
                        <group>
                            <field name="booking_date" readonly="True" />
                            <label for="street1" string="Address"/>
                            <div class="o_address_format">
                                <field name="street1" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city_id" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State" />
                                <field name="pincode" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country" />
                            </div>					
                            <field name="service_type"  options="{'horizontal': true}" widget="radio"/>
                            <field name="re_issue_reason" required="service_type in ('Re-Issue Of Passport')" invisible="service_type in ('Fresh Passport','PCC')" />
                            <field name="change_in_existing_personal_particulars"  widget="many2many_tags" invisible="service_type in ('Fresh Passport','PCC')" options="{'no_quick_create': True, 'no_create_edit': True, 'no_create': True, 'no_open': True}"/>
                            <field name="passport_type" options="{'horizontal': true}" widget="radio"/>
                            <field name="booklet_type" options="{'horizontal': true}" widget="radio"/>
                            <field name="fees_amount" />
                            <field name="paid_amount" />
                            <field name="due_amount"  />
                            <field name="aadhar_number" force_save="1" required="true" placeholder="Please Enter Aadhar Number"/>
                            <field name="pan_number" force_save="1" placeholder="Please Enter PAN Number"/>
                            <field name="voter_id_number" force_save="1" placeholder="Please Enter Voter ID Number"/>
                        </group>
                    </group>
                    <notebook>
                         <page string="Passport Details" >
                            <group >
                                <group>
                                    <label for="father_name" string="Father Name"/>
                                    <div class="o_td_label">
                                        <field name="father_name" placeholder="Enter First Name..."/>
                                        <field name="father_lname" placeholder="Enter Last Name..." nolabel="1"/>

                                    </div>
                                     <label for="mother_name" string="Mother Name"/>
                                    <div class="o_td_label">
                                        <field name="mother_name" placeholder="Enter First Name..."/>
                                        <field name="mother_lname" placeholder="Enter Last Name..." nolabel="1"/>

                                    </div>
                                     <label for="guardian_name" string="Guardian Name"/>
                                    <div class="o_td_label">
                                        <field name="guardian_name" placeholder="Enter First Name..."/>
                                        <field name="guardian_lname" placeholder="Enter Last Name..." nolabel="1"/>

                                    </div>
                                     <label for="spouse_name" string="Spouse Name"/>
                                    <div class="o_td_label">
                                        <field name="spouse_name" placeholder="Enter First Name..." required="marital_status in ('single')"/>
                                        <field name="spouse_lname" placeholder="Enter Last Name..." required="marital_status in ('single')" nolabel="1"/>

                                    </div>
                                </group>
                                <group>
                                    <field name="verification_date" />
                                    <field name="passport_city_id" options="{'no_quick_create': True, 'no_create_edit': True, 'no_create': True, 'no_open': True}"/>
                                    <field name="office_address_id" domain="[('city_id', '=', passport_city_id)]"  options="{'no_quick_create': True, 'no_create_edit': True, 'no_create': True}"/>
                                    <field name="ar_number" placeholder="Enter AR Number...." />
                                    <field name="file_number" placeholder="Enter File Number...." />
                                </group>
                            </group>
                        </page>
                        <page string="Document Details">
                            <field name="appointment_doc_ids" >
                                <tree editable="bottom">
                                    <field name="name" />
                                    <field name="doc_type_id" />
                                    <field name="doc_name" column_invisible="1" />
							    	<field name='doc_file' filename="doc_name" />
                                    <field name="is_require" />
                                </tree>
                            </field>
                        </page>
                        <page string="Office Details">
                            <group>
                                <group>
                                    <field name="passport_id" placeholder="Enter Passport  Form Email id ...." />
                                    <field name="new_passport_number" invisible="service_type == 'Re-Issue Of Passport'"/>
                                    <field name="new_passport_issue_date" invisible="service_type == 'Re-Issue Of Passport'"  />
                                    <field name="new_passport_expiry_date" invisible="service_type == 'Re-Issue Of Passport'"  />
                                    <field name="new_passport_place_of_issue" invisible="service_type == 'Re-Issue Of Passport'"  />
                                </group>
                                <group>
                                    <field name="password" />
                                    <field name="old_passport_number" invisible="service_type == 'Fresh Passport'" required="1"/>
                                    <field name="old_passport_issue_date" invisible="service_type == 'Fresh Passport'"  required="1" />
                                    <field name="old_passport_expiry_date" invisible="service_type == 'Fresh Passport'" required="1"  />
                                    <field name="old_passport_place_of_issue" invisible="service_type == 'Fresh Passport'"  required="1" />
                                </group>
                        </group>
                        </page>
                      
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_passport_appointment">
        <field name="name">Appointment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">appointment.appointment</field>
        <field name="view_mode">tree,form,kanban,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
        </field>
    </record>
</odoo>
