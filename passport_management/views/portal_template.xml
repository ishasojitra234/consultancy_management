<odoo>

<template id="user_dropdown" inherit_id="portal.user_dropdown">
		<xpath expr="//div[hasclass('dropdown-divider')]" position="after">
			<a groups="base.group_user" href="/ourservices" role="menuitem" class="dropdown-item ps-3">
				<i class="fa fa-user-o small text-muted" style="padding-left:5px;"/>   Passporter Profile
			</a>
		</xpath>
	</template>
	
	<template id="portal_my_home" inherit_id="portal.portal_my_home">
		<xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
			<t t-call="portal.portal_docs_entry">
				<t t-set="title">Customer</t>
				<t t-set="url">/ourservices</t>
				<t t-set="placeholder_count" t-value="'student_counts'" />
			</t>
		</xpath>
	</template>

</odoo>