<odoo>
   

    <record id="view_partner_tree_passport" model="ir.ui.view">
        <field name="name">res.partner.tree.partner</field>
        <field name="model">res.partner</field>
        <field eval="8" name="priority"/>
        <field name="arch" type="xml">
            <tree string="Contacts" sample="1" multi_edit="1">
                <field name="display_name" string="Name"/>
                <field name="phone" class="o_force_ltr" optional="show"/>
                <field name="mobile" optional="hide"/>
                <field name="email" optional="show"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user" domain="[('share', '=', False)]"/>
                <field name="city" optional="show"/>
                <field name="state_id" optional="hide" readonly="1"/>
                <field name="country_id" optional="show" readonly="1"/>
                <field name="parent_id" readonly="1" column_invisible="True"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>


    <record id="view_partner_form_passport" model="ir.ui.view">
        <field name="name">res.partner.simplified.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Partner">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_customer" type="object" class="oe_stat_button" icon="fa-list">
                            <field string="Appointment" name="appointment_count" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="avatar_128" invisible="1"/>
                    <field name="image_1920" widget='image' class="oe_avatar" options='{"preview_image": "avatar_128"}'/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Enter Name Here..."/>
                        </h1>
                    </div>
                    <br/>
                    <group>
                        <group>
                            <field name="first_name"/>
                            <field name="last_name" />
                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city_id" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'default_country_id': country_id}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                            </div>
                        </group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                            <field name="user_ids" invisible="1"/>
                            <field name="email" widget="email" context="{'gravatar_image': True}" required="user_ids"/>
                            <!-- <field name="journal_id" domain="[('type', 'in', ['cash', 'bank'])]" /> -->
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_res_partner_passport">
		<field name="name">Customer</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">res.partner</field>
		<field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_partner_form_passport"/>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				No Record Found
			</p>
		</field>
	</record>

    <record id="action_passport_partner_view_form" model="ir.actions.act_window.view">
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_partner_tree_passport" />
        <field name="act_window_id" ref="action_res_partner_passport" />
    </record>

</odoo>
