<odoo>

    <template id="service_menu_portal_view">
		<t t-call="portal.portal_layout" >
			<t t-call="portal.portal_table">	
				<thead > 
                    <center>
                        <span>
                            <!-- <h5 class="my-3">Our Services</h5> -->
                        <h2  class="my-3" style="color: #002D72; text-align: center; margin-bottom: 20px;">Our Services</h2>

                        </span>
                    </center>
				</thead>
                <tbody>
                    <t t-set="counter" t-value="0" />
                    <t t-foreach="services[:9]" t-as="service">
                        <t t-if="counter % 3 == 0">
                            <tr></tr>
                        </t>
                        <td class="p-2" >
                            <div class="student_portal_view text" style="display: flex; justify-content: center;">
                                <div class="student_tile_portal"
                                    style="margin: 10px auto; text-align: center; width: 250px; height: 250px; background-color: #044385; display: flex; flex-direction: column; justify-content: space-between; align-items: center; padding: 20px; border-radius: 8px;">
                                    <a class="dashboard_element_main_body list-group-item-action d-flex align-items-center justify-content-center"
                                    t-attf-href="/my/dashboard"
                                    style="text-decoration: none; color: inherit; display: flex; flex-direction: column; align-items: center; height: 100%; width: 100%;">
                                        <div class="image-container" style="flex: 1; display: flex; justify-content: center; align-items: center;">
                                            <img class="image oe_portal_img" 
                                                style="width: 100px; height: 100px;" 
                                                t-att-src="image_data_uri(service.website_image)" />
                                        </div>
                                        <div class="service-name" style="margin-top: auto;">
                                            <span style="color: #fff; font-weight: bold; font-size: 14px;" 
                                                t-field="service.name"></span>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </td>
                        <t t-if="counter % 3 == 2">
                            <tr></tr>
                        </t>
                        <t t-set="counter" t-value="counter + 1" />
                    </t>
                    <t t-if="counter % 3 != 0">
                        <tr></tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

</odoo>